rules_version = '2';

// Mọi truy cập từ trình duyệt đều bị chặn.
// Verso đọc/ghi Firestore hoàn toàn từ máy chủ bằng Admin SDK, nên client không cần
// và không được phép chạm vào dữ liệu. Không có đường nào để người lạ ghi rác vào.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
