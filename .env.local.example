# ─────────────────────────────────────────────────────────────
#  Verso — biến môi trường.
#  Tất cả đều CHỈ dùng ở máy chủ. KHÔNG đặt tiền tố NEXT_PUBLIC_
#  cho bất kỳ dòng nào dưới đây.
# ─────────────────────────────────────────────────────────────

# ── 1. Đọc trang sách (BẮT BUỘC) ──
# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=dan_khoa_cua_ban_vao_day

# ── 2. Lưu và phát hành bản đọc ──
# Thiếu phần này thì vẫn chuyển được trang sách, nhưng KHÔNG xuất bản
# và KHÔNG có thư viện. Giao diện sẽ nói rõ điều đó chứ không im lặng.
#
# Lấy tại: Firebase Console → ⚙ Project settings → Service accounts
#          → "Generate new private key" → tải file JSON về
# Rồi chép ba trường tương ứng từ file JSON đó vào đây.
# ⚠ KHÔNG commit file JSON đó.
FIREBASE_PROJECT_ID=verso-43e8b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@verso-43e8b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── 3. Giọng đọc tiếng Việt ──
# Dùng chung service account ở mục 2. Tài khoản đó cần hai quyền:
#   • roles/cloudtts.user            — gọi Cloud Text-to-Speech
#   • roles/storage.objectAdmin      — trên đúng thùng dưới đây
# và phải bật API texttospeech.googleapis.com cho project.
#
# Thùng lưu giọng đã tổng hợp. KHÔNG phải tuỳ chọn cho vui: thiếu nó thì
# mỗi lượt nghe lại tổng hợp lại từ đầu và tính tiền lại từ đầu.
VERSO_BUCKET_TIENG=verso-43e8b-tieng

# ── Ghi chú khi chạy TRÊN Cloud Run ──
# Cloud Run tự có danh tính riêng, nên ở đó chỉ cần GEMINI_API_KEY,
# FIREBASE_PROJECT_ID và VERSO_BUCKET_TIENG. Bỏ hẳn CLIENT_EMAIL và
# PRIVATE_KEY — không mang khoá lên máy chủ thì cũng không có gì để rò rỉ.
