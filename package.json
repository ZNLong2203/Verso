{
  "name": "verso",
  "version": "0.1.0",
  "private": true,
  "description": "Verso — bien trang sach giao khoa thanh ban nghe duoc cho hoc sinh khiem thi",
  "scripts": {
    "copy:pdf-worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/",
    "predev": "npm run copy:pdf-worker",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "prebuild": "npm run copy:pdf-worker",
    "build": "next build",
    "postbuild": "cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/ || true",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --conditions=react-server --experimental-strip-types --import ./test/register.mjs test/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "next": "^16.3.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
